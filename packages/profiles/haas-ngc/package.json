{
  "name": "@cnc/profile-haas-ngc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cnc/core": "*"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  },
  "cnc-workbench": {
    "profilePack": {
      "controllerKey": "haas-ngc",
      "validateAstExport": "haasNgcProfile",
      "ruleDocsExport": "haasNgcRuleDocs",
      "manifest": {
        "controllerKey": "haas-ngc",
        "name": "Haas NGC",
        "grammar": "haas-strict",
        "parseCompliance": "strict_haas"
      }
    }
  }
}
