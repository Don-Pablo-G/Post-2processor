{
  "name": "@cnc/profile-fanuc-iso",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cnc/core": "*"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  },
  "cnc-workbench": {
    "profilePack": {
      "controllerKey": "fanuc",
      "validateAstExport": "fanucIsoProfile",
      "ruleDocsExport": "fanucIsoRuleDocs",
      "manifest": {
        "controllerKey": "fanuc",
        "name": "Fanuc ISO",
        "grammar": ["haas-strict", "fanuc-strict"],
        "parseCompliance": "strict_fanuc"
      }
    }
  }
}
